# Directory where originals are stored (phone-like folders: Camera, Screenshots, …)
# Absolute path recommended. Relative paths resolve against the server/ directory.
STORAGE_ROOT=D:\Pictures\Cloud

# SQLite database path
DB_PATH=../data/photo_sync.db

# Pairing PIN shown on PC / set by you (Android enters this once).
# CHANGE THIS from the default — the server logs a warning at startup if you don't.
# Anyone who can reach this server on your network can pair a device using this PIN.
PAIR_PIN=123456

# Bind address — 0.0.0.0 listens on all LAN interfaces
HOST=0.0.0.0
PORT=8787

# Optional: if true, pairing PIN can be reused for multiple devices (LAN convenience)
PAIR_PIN_REUSABLE=true

# Optional: reject uploads declaring/reaching a size above this many bytes (default 20 GiB)
# MAX_UPLOAD_SIZE_BYTES=21474836480

# Optional: cap a single PUT .../chunk request body (default 16 MiB) — independent,
# smaller memory-safety limit on top of MAX_UPLOAD_SIZE_BYTES
# MAX_CHUNK_BYTES=16777216
